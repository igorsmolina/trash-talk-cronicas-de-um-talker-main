# Banco de dados (Postgres/Neon) - rode schema.sql nele antes de iniciar
DATABASE_URL="postgres://usuario:senha@seu-host.neon.tech/nome-do-db?sslmode=require"

# Porta em que o Flask vai escutar (opcional, padrão 5000)
PORT=5000

# "production" ativa cookies "secure" (só enviados via HTTPS) e desliga o
# modo debug do Flask. Deixe em branco/"development" no seu computador.
FLASK_ENV=development

# Origem do frontend, usada pelo CORS. Só importa se você servir o
# frontend separadamente do backend (ver README). Quando o Flask serve o
# frontend (padrão), pode deixar o valor abaixo mesmo assim.
FRONTEND_ORIGIN="http://localhost:5000"

# Chave da API da Groq (https://console.groq.com/keys), usada para gerar
# as respostas do TrashTalker no chat.
GROQ_API_KEY="sua-chave-aqui"

# SMTP usado para enviar o e-mail de redefinição de senha. Com Gmail,
# SMTP_PASSWORD precisa ser uma "senha de app" (myaccount.google.com/apppasswords),
# não a senha normal da conta. Se deixar em branco/errado, o link cai
# de volta para o console do servidor (ver backend/email_utils.py).
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="seu-email@gmail.com"
SMTP_PASSWORD="sua-senha-de-app-aqui"
SMTP_FROM="seu-email@gmail.com"
